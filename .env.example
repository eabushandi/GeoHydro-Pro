# GeoHydro Pro environment configuration (example - copy to .env, never commit .env)
#
# Phase 1 (desktop, offline) needs no environment variables.
# The variables below are reserved for the planned cloud backend (Phase 7)
# and are NOT read by any code yet.

# GEOHYDRO_ENV=development
# GEOHYDRO_API_BASE_URL=http://localhost:8000
# GEOHYDRO_DATABASE_URL=postgresql://user:password@localhost:5432/geohydro
# GEOHYDRO_SECRET_KEY=change-me
# GEOHYDRO_STORAGE_BUCKET=
# STRIPE_SECRET_KEY=        # sandbox key only until production approval
